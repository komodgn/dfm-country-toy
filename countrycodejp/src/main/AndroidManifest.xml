<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution">

    <!--
        Empty marker module: zero code, zero resources.
        android:hasCode="false" means not even a dex file is produced.
        "The fact that it is installed" is itself the country signal.
    -->
    <dist:module
        dist:instant="false"
        dist:title="@string/title_countrycodejp">

        <!--
          [Level 2] Google Play auto-installs this module only for users whose
          account country is JP. No in-app install button is needed.
        -->
        <dist:delivery>
            <dist:install-time>
                <dist:conditions>
                    <dist:user-countries>
                        <dist:country dist:code="JP" />
                    </dist:user-countries>
                </dist:conditions>
            </dist:install-time>
        </dist:delivery>

        <dist:fusing dist:include="true" />
    </dist:module>

    <application android:hasCode="false" />
</manifest>
